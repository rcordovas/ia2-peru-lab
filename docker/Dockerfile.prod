FROM node:22-bookworm-slim
WORKDIR /app
COPY package*.json ./
COPY vendor ./vendor
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force
COPY src ./src
COPY public ./public
ENV NODE_ENV=production LAB_MODE=false LOG_SESSION_TOKENS=false PORT=3000
USER node
EXPOSE 3000
CMD ["node", "src/server.js"]
